fn __browser_verification_exceptions_regexes() -> StringList {
    let list = StringList.new();

    list.push("Android \\d{2,}.*(?i:AppleWebKit)/.*Version/4\\.0.*(?i:Chrome)/\\d{3,}.*Mobile Safari");
    list.push("iPhone OS 15_.*Version/15\\.");
    list.push("(Kindle/|\\(Kobo )");
    list.push("Firefox/78");
    list.push("SeaMonkey/");
    list.push("Firefox/91");
    list.push("\\(X11; Linux.*\\).*Chrome/76\\.");
    list.push("QtWebEngine/.*Dooble/\\d{4}\\.\\d{2}\\.\\d{2}$");
    list.push("Tusky/");
    list.push("Chrome/[0-9\\.]+/[0-9]+");
    list.push("Mozilla/5\\.0 \\(Windows NT 6\\.1; WOW64\\) AppleWebKit/535\\.2 \\(KHTML, like Gecko\\) Chrome/15\\.0\\.874\\.92 Safari/535\\.2");
    list.push("Falkon/");
    list.push("(?i:SamsungBrowser)/\\d\\d");
    list.push("(?i:Android \\d+; FP3 Build/)");

    return list
 }
