import configuration.Config;

fn __cookie_monster_init() -> ()? {
    let list = StringList.new();
    list.push("git/");
    list.push("Go-http-client/");
    list.push("link_checker/");
    list.push("docker/");
    list.push("@actions/artifact-");
    list.push("melpa.org");
    list.push("got (https://github.com/sindresorhus/got)");
    list.push("GoModuleMirror/1.0 (+https://proxy.golang.org)");
    list.push("curl/");
	list.push("Wget/");

    globals.add(
        "NSOE_PATTERNS_COOKIE_MONSTER_FORGEJO_ALLOWED_AGENTS",
        Matcher.from_patterns(list)?
    );

    Some(())
}
fn __browser_verification_safari_regexes() -> StringList {
    let list = StringList.new();

    list.push("(?i:Version)/(\\d|1[0-5])\\.");
    list.push("Chrome/");

    return list
}
fn __browser_verification_firefox_regexes() -> StringList {
    let list = StringList.new();

    list.push("(?i:Firefox|FxiOS)/\\d{1,2}\\.");
    list.push("(?i:Firefox|FxiOS)/(\\d{1,2}\\.?)+esr");

    return list
}
fn __browser_verification_fake_firefox_regexes() -> StringList {
    let list = StringList.new();

    list.push("Firefox$");
    list.push("(?i:Firefox)/\\d+$");
    list.push("(?i:Firefox) ?\\d{1,2}\\.");
    list.push("^(?i:Firefox)/([^ ]+)$");
    list.push("rv:\\{version\\}.*Firefox/");

    return list
}
fn __browser_verification_patterns_obsolete_engines() -> StringList {
    let list = StringList.new();

    list
      .push("Mozilla/4.")
      .push("MSIE")
      .push("Trident")
      .push("Presto");

    return list
}
fn __browser_verification_regexes_fake_engines() -> StringList {
    let list = StringList.new();

    list.push("(?i:Mozilla)/[0-46-9]\\d*\\.");
    list.push("Gecko/.*Safari");
    list.push("^Mozilla/.*Mozilla/");

    return list
}
fn __browser_verification_edge_regexes() -> StringList {
    let list = StringList.new();

    list.push("(?i:Edg|EdgiOS)/\\d{1,2}\\.");

    return list
}
fn __browser_verification_chrome_regexes() -> StringList {
    let list = StringList.new();

    list.push("(?i:Chrome|CriOS)/\\d{1,2}\\.");

    return list
}
fn __browser_verification_patterns_faked_platforms() -> StringList {
    let list = StringList.new();

    list
      .push("Windows CE")
      .push("Windows 95")
      .push("Windows 98")
      .push("Windows 9x")
      .push("Win95")
      .push("Win98")
      .push("Windows 3")
      .push("WinNT4.0")
      .push("PPC Mac OS")
      .push("OS/2");

    return list
}
