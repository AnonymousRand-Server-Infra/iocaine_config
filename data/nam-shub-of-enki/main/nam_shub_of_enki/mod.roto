fn incantation(request: Request) -> String? {
    let config = configuration.from_globals()?;
    let metadata = HashMap.new();
    let decision = detect.detect(config, request, metadata);

    if config.logging.enable {
        let request_id = request.header("x-request-id");
        if request_id != "" {
            metadata.insert_str("request-id", request.header("x-request-id"));
        }
        if not metadata.has("request") {
            let req = HashMap.new();
            let headers = HashMap.new();
            headers.insert_str("host", request.header("host"));
            headers.insert_str("user-agent", request.header("user-agent"));
            headers.insert_str("x-forwarded-for", request.header("x-forwarded-for"));
            headers.insert_str("priority", request.header("priority"));
            let sfm = request.header("sec-fetch-mode");
            if sfm != "" {
                headers.insert_str("sec-fetch-mode", sfm);
            }
            let sfd = request.header("sec-fetch-dest");
            if sfd != "" {
                headers.insert_str("sec-fetch-dest", sfd);
            }
            let secchua = request.header("sec-ch-ua");
            if secchua != "" {
                headers.insert_str("sec-ch-ua", secchua);
                headers.insert_str("sec-ch-ua-platform", request.header("sec-ch-ua-platform"));
            }
            let xrw = request.header("x-requested-with");
            if xrw != "" {
                headers.insert_str("x-requested-with", xrw);
            }
    
            req.insert_map("header", headers);
            req.insert_str("method", request.method());
            req.insert_str("path", request.path());
    
            metadata.insert_map("request", req);
        }
    
        if config.logging.classification.enable {
            let classification = classify.classify(config, request, metadata)?;
            metadata.insert_str("classification", classification);
        
            METRIC_REQUEST_DISTRIBUTION.inc_for2(classification, metadata.get("verdict.outcome")?.as_str()?);
        }
    
        metadata.insert_str("_msg", "handling request");
        metadata.insert_str("service", "nam-shub-of-enki");
        Logger.stdout(metadata.into_value().to_json()?)
    }
    let ruleset = metadata.get("ruleset")?.as_str()?;
    let xff = request.header("x-forwarded-for");
    if xff != "" && FIREWALLED_RULESETS.matches(ruleset) {
        Firewall.block(xff);
    }

    return decision
}
fn utterance(request: Request, decision: String?) -> Response? {
    let config = configuration.from_globals()?;
    return responses.generate(config, request, decision);
}
test detect_monocles {
    let request = tests
      .make_request("test-host", "/test-path")
      .user_agent("Mozilla/5.0 (Linux; Android 7.1.2; SM-T217T Build/N2G47E; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/119.0.6045.134 Safari/537.36")
      .header("sec-fetch-mode", "document")
      .header("x-requested-with", "de.monocles.browser")
      .build();
    tests.assert_rejected(request)
}
