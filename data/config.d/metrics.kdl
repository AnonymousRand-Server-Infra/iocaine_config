prometheus-server metrics {
    // SYNC: socket with nginx!! (i don't think there's a way to fill this from an env var >w<)
    bind "/run/sockets/iocaine_metrics.sock" unix-socket-access="group"
    persist-path "/run/iocaine/qmk-metrics.json"
    persist-interval "1h"
}

http-server default {
    use handler-from=nam-shub-of-enki metrics=metrics
}
