// SYNC: all paths inside container!
declare-handler nam-shub-of-enki path="${IOCAINE_CONFIG_DEST_DIR}/nam-shub-of-enki" {
    inherits "default"

    sources {
        training-corpus "${IOCAINE_CONFIG_DEST_DIR}/corpus/das_kapital_i.txt"
        wordlists "${IOCAINE_CONFIG_DEST_DIR}/corpus/words.txt"
    }

    checks {
        ai-robots-txt {
            enable
            path "${IOCAINE_CONFIG_DEST_DIR}/ai.robots.txt-robots.json"
        }
        // this should be a unique, identifiable word to tell what requests came from the maze
        generated-urls {
            identifiers "meow-meow-meow"
        }

        enable ai-agents
        enable big-tech
        enable commercial-scrapers
        enable firefox-ai
        disable archivers
    }
}
