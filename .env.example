PATH_TO_ROOT_DOCKER_PROJ=../../
PATH_FROM_ROOT_TO_UTILS=utils/
PATH_FROM_ROOT_TO_IOCAINE=proxy/iocaine/

IOCAINE_SCKT=<...>
IOCAINE_METRICS_SCKT=<...>

# note: if there are multiple space-separated pieces here, this `.env` file cannot be sourced
# in a script without `set +x`
IOCAINE_CONFIG_SRC_FILES=proxy/iocaine/data/* services/git_server/deployment/iocaine/data/*
IOCAINE_CONFIG_DEST_DIR=/data/
IOCAINE_RUN_DEST_DIR=/run/iocaine/

# `.env` files needed for `envsubst` of config files
ENVSUBST_ENV_FILE_1=./.env
ENVSUBST_ENV_FILE_2=../../services/git_server/.env

# a user with git credentials that is used to automatically commit after updating ai robots list
GIT_USER=<username>
