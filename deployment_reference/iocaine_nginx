# EVERY site should set `$upstream_location`,
# and those wanting iocaine should set `$enable_iocaine` to `1`
map "$enable_iocaine:$request_method" $final_upstream_location {
    # this should be iocaine's port
    "1:GET"  http://127.0.0.1:42069;
    "1:HEAD" http://127.0.0.1:42069;
    default  $upstream_location;
}

